{
  "schemaVersion": 1,
  "name": "private-advisory",
  "advisory": true,
  "description": "Private repository on a plan without rulesets or auto-merge: the same targets as oss, reported and never applied. Features the plan lacks (rulesets, private vulnerability reporting, code scanning, secret scanning) are reported as unavailable.",
  "repo": {
    "allow_merge_commit": false,
    "allow_squash_merge": true,
    "allow_rebase_merge": false,
    "delete_branch_on_merge": true
  },
  "actions": {
    "enabled": true,
    "allowed_actions": "all"
  },
  "workflow": {
    "default_workflow_permissions": "read",
    "can_approve_pull_request_reviews": true
  },
  "security": {
    "dependabot_alerts": true,
    "dependabot_security_updates": true
  },
  "rulesets": [
    {
      "name": "main",
      "target": "branch",
      "enforcement": "active",
      "conditions": {
        "ref_name": {
          "include": [
            "refs/heads/main"
          ],
          "exclude": []
        }
      },
      "bypass_actors": [],
      "rules": [
        {
          "type": "deletion"
        },
        {
          "type": "non_fast_forward"
        },
        {
          "type": "required_linear_history"
        },
        {
          "type": "pull_request",
          "parameters": {
            "required_approving_review_count": 0,
            "dismiss_stale_reviews_on_push": false,
            "require_code_owner_review": false,
            "require_last_push_approval": false,
            "required_review_thread_resolution": true,
            "allowed_merge_methods": [
              "squash"
            ]
          }
        }
      ]
    }
  ],
  "callers": [],
  "files": [
    ".github/dependabot.yml"
  ]
}
